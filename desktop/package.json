{
  "name": "akron-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Akron desktop application",
  "author": "apxllo",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "npm run typecheck && npm run compile && npm run compile:renderer && node scripts/build.mjs && electron-builder",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "compile:renderer": "tsc -p renderer/tsconfig.json",
    "start": "npm run compile && npm run compile:renderer && node scripts/build.mjs && electron ."
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.apxllo.akron",
    "productName": "Akron",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "akron-runtime",
        "filter": ["**/*"]
      }
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
